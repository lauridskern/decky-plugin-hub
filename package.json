{
  "name": "plugin-hub",
  "version": "0.1.0",
  "description": "Install Decky plugins from GitHub releases and keep them up to date",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "github",
    "updater"
  ],
  "author": "Laurids Kern",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lauridskern/decky-plugin-hub"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "^1.4.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
